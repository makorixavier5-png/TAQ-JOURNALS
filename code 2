<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- PWA & Mobile App Meta Tags -->
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#07090d">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-192.png">

<title>THE AFRICAN QUANTUM — Trading Journal</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg:#07090d;--bg2:#0c0f15;--bg3:#111620;--bg4:#181e2b;--bg5:#1e2636;
  --border:rgba(255,255,255,0.06);--border2:rgba(255,255,255,0.12);--border3:rgba(255,255,255,0.2);
  --text:#d4dde8;--text2:#7a8fa8;--text3:#3d5068;--text4:#1e2e3d;
  --green:#00e599;--green2:rgba(0,229,153,0.08);--green3:rgba(0,229,153,0.18);
  --red:#ff4d6a;--red2:rgba(255,77,106,0.08);--red3:rgba(255,77,106,0.18);
  --gold:#f0b429;--gold2:rgba(240,180,41,0.1);
  --blue:#4d9fff;--blue2:rgba(77,159,255,0.1);
  --purple:#a78bfa;--purple2:rgba(167,139,250,0.1);
  --cyan:#22d3ee;--cyan2:rgba(34,211,238,0.08);
  --orange:#ff8a3d;--orange2:rgba(255,138,61,0.1);
  --pink:#ff5ea8;--pink2:rgba(255,94,168,0.1);
  --mono:'DM Mono',monospace;--display:'Syne',sans-serif;
  --r:6px;--r2:10px;--r3:14px;
  --brand-grad:linear-gradient(135deg,var(--green) 0%,var(--cyan) 25%,var(--blue) 50%,var(--purple) 75%,var(--gold) 100%);
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--text);font-family:var(--mono);font-size:12px;min-height:100vh;overflow-x:hidden;}
body::after{content:'';position:fixed;inset:0;background:
  radial-gradient(ellipse 60% 40% at 15% -5%,rgba(0,229,153,0.08),transparent),
  radial-gradient(ellipse 60% 40% at 85% -5%,rgba(240,180,41,0.07),transparent),
  radial-gradient(ellipse 70% 50% at 50% 110%,rgba(167,139,250,0.06),transparent),
  radial-gradient(ellipse 80% 50% at 50% -10%,rgba(77,159,255,0.06),transparent);
  pointer-events:none;z-index:0;}
nav::before{content:'';position:absolute;left:0;right:0;bottom:-2px;height:2px;background:var(--brand-grad);opacity:0.8;}

/* SCROLLBAR */
::-webkit-scrollbar{width:4px;height:4px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--bg5);border-radius:2px;}

/* ── NAV ── */
nav{position:fixed;top:0;left:0;right:0;z-index:200;background:rgba(7,9,13,0.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 28px;height:56px;}
.brand{font-family:var(--display);font-size:17px;font-weight:800;letter-spacing:0.02em;color:#fff;display:flex;align-items:center;gap:10px;}
.brand-name{background:var(--brand-grad);background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:brandshift 6s linear infinite;}
@keyframes brandshift{to{background-position:200% center;}}
.brand-icon{width:32px;height:32px;background:conic-gradient(from 180deg,var(--green),var(--cyan),var(--blue),var(--purple),var(--gold),var(--orange),var(--green));border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;box-shadow:0 0 14px rgba(0,229,153,0.35);overflow:hidden;padding:2px;}
.brand-icon img{width:100%;height:100%;object-fit:cover;border-radius:7px;}
.brand-sub{font-size:9px;font-weight:500;background:var(--brand-grad);-webkit-background-clip:text;background-clip:text;color:transparent;letter-spacing:0.2em;text-transform:uppercase;display:block;line-height:1;margin-top:2px;}
.nav-tabs{display:flex;gap:2px;}
.ntab{font-family:var(--display);font-size:11px;font-weight:600;letter-spacing:0.05em;padding:6px 14px;border:none;background:none;color:var(--text2);cursor:pointer;border-radius:var(--r);transition:all 0.15s;text-transform:uppercase;position:relative;}
.ntab:hover{color:var(--text);background:var(--bg3);}
.ntab.active{color:#fff;background:var(--bg4);}
.ntab.active::after{content:'';position:absolute;left:10px;right:10px;bottom:2px;height:2px;border-radius:2px;background:var(--brand-grad);}
.nav-right{display:flex;align-items:center;gap:12px;}
.week-selector{display:flex;align-items:center;gap:8px;background:var(--bg3);border:1px solid var(--border);border-radius:var(--r);padding:5px 10px;}
.week-selector select{font-family:var(--mono);font-size:10px;background:none;border:none;color:var(--text);outline:none;cursor:pointer;}
.week-selector input[type=date]{font-family:var(--mono);font-size:10px;background:none;border:none;color:var(--text);outline:none;cursor:pointer;}
.btn-primary{font-family:var(--display);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:7px 16px;background:var(--brand-grad);background-size:200% auto;color:#07090d;border:none;border-radius:var(--r);cursor:pointer;transition:all 0.2s;box-shadow:0 2px 12px rgba(0,229,153,0.25);}
.btn-primary:hover{opacity:0.9;background-position:100% center;box-shadow:0 2px 18px rgba(0,229,153,0.4);}

/* ── PAGES ── */
.page{display:none;padding-top:72px;min-height:100vh;position:relative;z-index:1;}
.page.active{display:block;}

/* ── STAT CARDS ── */
.stat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px;padding:20px 24px 0;}
.stat-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:14px 16px;animation:fadeUp 0.3s ease both;}
.stat-card.green{border-color:rgba(0,229,153,0.2);}
.stat-card.red{border-color:rgba(255,77,106,0.2);}
.stat-card.gold{border-color:rgba(240,180,41,0.2);}
.stat-card.purple{border-color:rgba(167,139,250,0.25);}
.stat-card.orange{border-color:rgba(255,138,61,0.25);}
.stat-card.blue{border-color:rgba(77,159,255,0.25);}
.sc-label{font-size:8px;letter-spacing:0.18em;text-transform:uppercase;color:var(--text3);margin-bottom:6px;}
.sc-val{font-family:var(--display);font-size:22px;font-weight:800;color:#fff;line-height:1;}
.sc-val.pos{color:var(--green);}
.sc-val.neg{color:var(--red);}
.sc-val.gold{color:var(--gold);}
.sc-val.purple{color:var(--purple);}
.sc-val.orange{color:var(--orange);}
.sc-val.blue{color:var(--blue);}
.sc-sub{font-size:9px;color:var(--text3);margin-top:4px;}

/* ── SECTION HEADERS ── */
.sec-head{display:flex;align-items:center;justify-content:space-between;padding:20px 24px 12px;}
.sec-title{font-family:var(--display);font-size:14px;font-weight:700;color:#fff;letter-spacing:0.02em;}
.sec-badge{font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text3);background:var(--bg3);border:1px solid var(--border);border-radius:20px;padding:3px 10px;}

/* ── TABLE ── */
.tbl-wrap{padding:0 24px 20px;overflow-x:auto;}
table{width:100%;border-collapse:collapse;min-width:900px;}
thead th{font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:var(--text3);padding:8px 10px;text-align:left;border-bottom:1px solid var(--border);white-space:nowrap;}
tbody tr{border-bottom:1px solid var(--border);transition:background 0.12s;cursor:pointer;animation:fadeUp 0.25s ease both;}
tbody tr:hover{background:var(--bg3);}
tbody td{padding:10px 10px;font-size:11px;color:var(--text);vertical-align:middle;white-space:nowrap;}
td.ticker{font-family:var(--display);font-weight:700;font-size:13px;color:#fff;}
td.pos{color:var(--green);font-weight:500;}
td.neg{color:var(--red);font-weight:500;}
td.gold{color:var(--gold);}
.badge{display:inline-flex;align-items:center;font-size:8px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;padding:2px 8px;border-radius:20px;}
.badge-long{background:var(--green3);color:var(--green);}
.badge-short{background:var(--red3);color:var(--red);}
.badge-win{background:var(--green2);color:var(--green);border:1px solid rgba(0,229,153,0.3);}
.badge-loss{background:var(--red2);color:var(--red);border:1px solid rgba(255,77,106,0.3);}
.badge-be{background:var(--bg4);color:var(--text2);border:1px solid var(--border);}
.badge-a{background:rgba(0,229,153,0.15);color:var(--green);}
.badge-b{background:rgba(77,159,255,0.15);color:var(--blue);}
.badge-c{background:rgba(240,180,41,0.15);color:var(--gold);}
.badge-d{background:rgba(255,77,106,0.15);color:var(--red);}
.grade-dot{width:6px;height:6px;border-radius:50%;display:inline-block;margin-right:4px;}
.thumb-cell img{width:40px;height:30px;object-fit:cover;border-radius:3px;border:1px solid var(--border);}
.thumb-cell span{font-size:9px;color:var(--text3);}

/* ── PANELS / CARDS ── */
.panel-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:0 24px 20px;}
.panel-grid.three{grid-template-columns:1fr 1fr 1fr;}
.panel{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:18px;}
.panel-title{font-size:9px;letter-spacing:0.18em;text-transform:uppercase;color:var(--text3);margin-bottom:14px;}

/* ── WEEKLY TRACKER TABLE ── */
.weekly-grid{padding:0 24px 20px;}
.day-block{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);margin-bottom:10px;overflow:hidden;}
.day-header{display:grid;grid-template-columns:120px 1fr 90px 90px 90px;align-items:center;gap:12px;padding:12px 16px;background:var(--bg3);border-bottom:1px solid var(--border);}
.day-name{font-family:var(--display);font-size:13px;font-weight:700;color:#fff;}
.day-summary{font-size:10px;color:var(--text2);}
.day-pips-pos{font-weight:600;color:var(--green);}
.day-pips-neg{font-weight:600;color:var(--red);}
.day-trades-hdr{font-size:9px;color:var(--text3);text-align:right;}

.pair-row{display:grid;grid-template-columns:120px 140px 120px 90px 90px 90px 1fr;align-items:center;gap:12px;padding:10px 16px;border-bottom:1px solid var(--border);}
.pair-row:last-child{border-bottom:none;}
.pair-row.empty{opacity:0.3;}
.pair-input{font-family:var(--mono);font-size:11px;background:var(--bg4);border:1px solid var(--border);border-radius:4px;color:var(--text);padding:5px 8px;width:100%;outline:none;transition:border-color 0.15s;}
.pair-input:focus{border-color:var(--border2);}
.pair-select{font-family:var(--mono);font-size:11px;background:var(--bg4);border:1px solid var(--border);border-radius:4px;color:var(--text);padding:5px 8px;width:100%;outline:none;}
.pair-row-label{font-size:9px;color:var(--text3);letter-spacing:0.1em;}

/* ── PAIR SUMMARY ── */
.pair-summary-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;padding:0 24px 20px;}
.pair-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:14px 16px;}
.pair-card-name{font-family:var(--display);font-size:15px;font-weight:700;color:#fff;margin-bottom:8px;}
.pair-card-stats{display:flex;flex-direction:column;gap:5px;}
.pair-stat-row{display:flex;justify-content:space-between;font-size:10px;}
.pair-stat-label{color:var(--text3);}
.pair-trade-day{display:flex;align-items:center;justify-content:space-between;padding:3px 0;font-size:10px;border-bottom:1px solid var(--border);}
.pair-trade-day:last-child{border-bottom:none;}

/* ── ACCOUNT MONITORING ── */
.account-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:0 24px 20px;}
.account-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:18px;}
.acct-week-row{display:grid;grid-template-columns:80px 100px 100px 100px 90px 90px 80px 110px;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);font-size:11px;}
.acct-week-row:last-child{border-bottom:none;}
.acct-week-head{display:grid;grid-template-columns:80px 100px 100px 100px 90px 90px 80px 110px;gap:10px;padding:6px 0 10px;border-bottom:1px solid var(--border2);}
.acct-week-head span{font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:var(--text3);}

/* ── CHART BARS ── */
.bar-chart{display:flex;align-items:flex-end;gap:6px;height:80px;margin-top:10px;}
.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;}
.bar-fill{width:100%;border-radius:3px 3px 0 0;min-height:2px;transition:height 0.6s ease;}
.bar-lbl{font-size:8px;color:var(--text3);letter-spacing:0.05em;}

/* ── MODAL ── */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:800;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity 0.2s;}
.overlay.open{opacity:1;pointer-events:auto;}
.modal{background:var(--bg2);border:1px solid var(--border2);border-radius:var(--r3);width:720px;max-width:96vw;max-height:90vh;overflow-y:auto;padding:28px;transform:translateY(16px);transition:transform 0.2s;}
.overlay.open .modal{transform:translateY(0);}
.modal-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;padding-bottom:14px;border-bottom:1px solid var(--border);}
.modal-hd h2{font-family:var(--display);font-size:16px;font-weight:800;color:#fff;}
.modal-close{background:none;border:none;color:var(--text2);font-size:22px;cursor:pointer;line-height:1;padding:0;}
.modal-close:hover{color:#fff;}
.fgrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;}
.fgroup{display:flex;flex-direction:column;gap:5px;}
.fgroup.full{grid-column:1/-1;}
.fgroup.half{grid-column:span 2;}
label{font-size:8px;letter-spacing:0.16em;text-transform:uppercase;color:var(--text3);}
input[type=text],input[type=number],input[type=date],input[type=time],input[type=url],select,textarea{font-family:var(--mono);font-size:11px;background:var(--bg3);border:1px solid var(--border);border-radius:var(--r);color:var(--text);padding:8px 10px;outline:none;width:100%;transition:border-color 0.15s;}
input:focus,select:focus,textarea:focus{border-color:rgba(77,159,255,0.5);}
select option{background:var(--bg3);}
textarea{resize:vertical;line-height:1.6;}
.dir-btns{display:grid;grid-template-columns:1fr 1fr;gap:6px;}
.dir-btn{font-family:var(--display);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:9px;border:1px solid var(--border);border-radius:var(--r);background:var(--bg3);color:var(--text2);cursor:pointer;transition:all 0.15s;text-align:center;}
.dir-btn.long.active{background:var(--green3);border-color:var(--green);color:var(--green);}
.dir-btn.short.active{background:var(--red3);border-color:var(--red);color:var(--red);}
.emotion-row,.tag-row{display:flex;flex-wrap:wrap;gap:6px;}
.etag,.mtag{font-family:var(--mono);font-size:9px;letter-spacing:0.08em;text-transform:uppercase;padding:4px 10px;border:1px solid var(--border);border-radius:20px;background:none;color:var(--text2);cursor:pointer;transition:all 0.15s;}
.etag.active{border-color:var(--gold);color:var(--gold);background:var(--gold2);}
.mtag.active{border-color:var(--red);color:var(--red);background:var(--red2);}
.modal-footer{display:flex;justify-content:flex-end;gap:10px;margin-top:22px;padding-top:16px;border-bottom:0;border-top:1px solid var(--border);}
.btn-cancel{font-family:var(--display);font-size:10px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;padding:8px 18px;background:none;border:1px solid var(--border);color:var(--text2);border-radius:var(--r);cursor:pointer;transition:all 0.15s;}
.btn-cancel:hover{border-color:var(--border2);color:var(--text);}
.btn-save{font-family:var(--display);font-size:10px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:8px 22px;background:var(--green);color:#07090d;border:none;border-radius:var(--r);cursor:pointer;transition:opacity 0.15s;}
.btn-save:hover{opacity:0.85;}

/* edit/delete buttons */
.act-btn{font-family:var(--mono);font-size:9px;padding:3px 8px;border-radius:4px;border:1px solid var(--border);background:none;color:var(--text2);cursor:pointer;transition:all 0.12s;margin-right:4px;}
.act-btn.edit:hover{border-color:var(--blue);color:var(--blue);}
.act-btn.del:hover{border-color:var(--red);color:var(--red);}

/* ── EMPTY ── */
.empty-msg{text-align:center;padding:50px 20px;color:var(--text3);}
.empty-msg .em-icon{font-size:32px;margin-bottom:10px;opacity:0.25;}
.empty-msg p{font-size:10px;letter-spacing:0.1em;text-transform:uppercase;}

/* ── ANIMATIONS ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
.fade-up{animation:fadeUp 0.3s ease both;}

/* screenshot preview */
.ss-preview{width:100%;max-height:120px;object-fit:contain;border-radius:4px;border:1px solid var(--border);margin-top:6px;display:none;}

/* Import/Export bar */
.io-bar{display:flex;gap:8px;padding:12px 24px 0;flex-wrap:wrap;}
.btn-sm{font-family:var(--mono);font-size:9px;letter-spacing:0.08em;text-transform:uppercase;padding:5px 12px;border-radius:var(--r);border:1px solid var(--border);background:var(--bg3);color:var(--text2);cursor:pointer;transition:all 0.15s;}
.btn-sm:hover{border-color:var(--border2);color:var(--text);}

/* Equity mini chart canvas */
#equityCanvas{width:100%;height:80px;display:block;}

/* divider */
.divider{height:1px;background:var(--border);margin:0 24px 20px;}

/* ── WELCOME SPLASH ── */
#welcome-splash{position:fixed;inset:0;z-index:2000;background:radial-gradient(ellipse 90% 70% at 50% 30%,#0c1420 0%,#07090d 70%);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;cursor:pointer;transition:opacity 0.6s ease,visibility 0.6s;padding:20px;}
#welcome-splash.hide{opacity:0;visibility:hidden;pointer-events:none;}
.ws-icon{width:64px;height:64px;border-radius:16px;background:conic-gradient(from 180deg,var(--green),var(--cyan),var(--blue),var(--purple),var(--gold),var(--orange),var(--green));display:flex;align-items:center;justify-content:center;font-size:30px;margin-bottom:22px;box-shadow:0 0 40px rgba(0,229,153,0.35);animation:wsPulse 2.4s ease-in-out infinite;}
@keyframes wsPulse{0%,100%{transform:scale(1);}50%{transform:scale(1.06);}}
.ws-title{font-family:var(--display);font-weight:800;font-size:clamp(20px,4vw,36px);letter-spacing:0.02em;line-height:1.3;background:var(--brand-grad);background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:brandshift 5s linear infinite;max-width:820px;}
.ws-tagline{margin-top:18px;font-family:var(--display);font-weight:700;font-size:clamp(13px,2vw,17px);letter-spacing:0.12em;text-transform:uppercase;color:#fff;}
.ws-hint{margin-top:34px;font-size:9px;letter-spacing:0.2em;text-transform:uppercase;color:var(--text3);}
</style>
</head>
<body>

<!-- ═══ WELCOME SPLASH ═══ -->
<div id="welcome-splash" onclick="dismissWelcome()">
  <div class="ws-icon">⚡</div>
  <div class="ws-title">WELCOME TO<br>THE AFRICAN QUANTUM DYNASTY</div>
  <div class="ws-tagline">We execute. We don't guess.</div>
  <div class="ws-hint">Tap anywhere to enter</div>
</div>

<!-- ═══ NAV ═══ -->
<nav>
  <div class="brand">
    <div class="brand-icon"><img src="data:image/jpeg;base64,